;.TITLE	THUNK	- Threaded code helpers

;.INCLUDE /macros.inc/

;; Fixed address to avoid massive Relocation of the Threaded code
;.ASECT
;. = ASTACK


.MACRO	.OFF	off, sym
	o	= sym - $BASE / 2
	.IIF GT o - 127. 	.ERROR	offset is out of bounds
	.IIF GT <-128.> - o	.ERROR	offset is out of bounds
	off	== o
.ENDM	.OFF

.MACRO	D.OFF	sym
	o	= . - $OBASE / 2
	.IIF GT o - 255. 	.ERROR	offset is out of bounds
	sym	== o - 128.
	sym'.::
.ENDM	D.OFF


;;----------------------------------------------
;; Thunks used in CRT only


$INVOK:: MOV	SP, R0
	MOVB	(RT), R1
	ADD	SP, R1
	PUSH	(R1)		; C-function address
	MOV	SAVRT, (R1)	; Save previous SAVRT to former function address
	MOV	RT, SAVRT
	MOV	(R0)+, R1
	MOV	(R0)+, R2
	MOV	(R0)+, R3
	MOV	(R0)+, R4
	MOV	(R0)+, R5
	CLR	R0
	JSR	RC, @(SP)+
$INVOR::MOV	(PC)+, RT
SAVRT:	.WORD	0		; Previous value of RT
	MOVB	(RT)+, R2
	ADD	R2, SP		; unwind arguments
	POP	SAVRT		; Restore previous SAVRT
	MOVB	(RT)+, R2
	BEQ	9$		; void return type
	BPL	8$		; int return type
	PUSH	R1		; long return type
8$:	PUSH	R0
9$:	.NEXT

;; switch implementation
T$SWIT::
	POP	R2		; selector
	ADD	(RT)+, RT	; case table
	MOV	(RT)+, R3	; count
	BEQ	TJMP
1$:	CMP	(RT)+, R2
	BEQ	TJMP
	TST	(RT)+
	SOB	R3, 1$
	BR	TJMP


$OBASE::

;; Pop into $SCRAT
D.OFF	SAV$
	MOV	(RT)+, R3
	INC	R3
	BIC	#1, R3
	MOV	SP, R0
	MOV	#$SCRAT, R2
1$:	MOVB	(R0)+, (R2)+
	SOB	R3, 1$
	MOV	R0, SP
	.NEXT

;; Push from	$SCRAT
D.OFF	RST$
	MOV	#$SCRAT, R2
	BR	DRD2

; Special case. 16-bit hardware registers must be accessed by single instruction
D.OFF	I$WRI
	POP	R1
	MOV	R1, @(SP)
	BR	RET.R1

D.OFF	C$WRI
	POP	R1
	MOVB	R1, @(SP)
	BR	RET.R1

D.OFF	$WRIT
	MOV	(RT)+, R3	; R3: size (bytes)
	MOV	R3, R1		; R1: size
	MOV	SP, R0
	ADD	R3, R0		; R0: behind value, points to address
	ADD	(R0), R1	; R1: behind destination
1$:	MOVB	-(R0), -(R1)
	MOVB	(R0), 2(R0)	; shift value up in stack
	SOB	R3, 1$
			; Fallthrough
;; Invoked by JSR RT, T$ENTR
T$ENTR::
	TST	(SP)+
	.NEXT

D.OFF	AD$SP
	ADD	(RT)+, SP
	.NEXT


D.OFF	I$ASL
	ASL	(SP)
	.NEXT

D.OFF	P$ONE
	PUSH	#2
D.OFF	I$ASR
	ASR	(SP)
	.NEXT


;; push address of local var or function arg
D.OFF	P$LAD
	MOV	SP, R1
	ADD	(RT)+, R1
	BR	PUR1

D.OFF	PU$SP
	MOV	SP, R1		; MOV SP, -(SP)  instruction has Undefined Behavior on different PDP-11
	BR	PUR1

D.OFF	AD$16
	ADD	(RT)+, (SP)
	.NEXT


; Special case. 16-bit hardware registers must be accessed by single instruction
D.OFF	I$RD
	MOV	@(SP), (SP)
	.NEXT

;; Duplicate address and Read. Used for Assignments
D.OFF	$DRD
	PUSH	(SP)
D.OFF	$READ
	POP	R2
DRD2:	MOV	SP, R0
	SUB	(RT), R0
	BIC	#1, R0
	MOV	R0, SP
	CLR	(SP)			; cast `char` as (int)(unsigned char)
	BR	CPB


D.OFF	CP$ST
	MOV	(RT)+, R2
	MOV	SP, R0
CPB:	MOV	(RT)+, R3
1$:	MOVB	(R2)+, (R0)+
	SOB	R3, 1$
	.NEXT


;; Allocate zero-initialized space for local variable
D.OFF	Z$ST
	MOV	(RT)+, R0
1$:	CLR	-(SP)
	SUB	#2, R0
	BGT	1$
	.NEXT



;!!!R RETLNG::POP	R0, R1
;!!!R 	ADD	(RT), SP
;!!!R 	.NEXT




;!!!R RETINT:	POP	R0
D.OFF	SK$ST
	MOV	(RT)+, R2
	INC	R2
	BIC	#1, R2
	CMP	R2, #2
	BEQ	IPOP
	CMP	R2, #4
	BEQ	L$POP
	ADD	R2, SP
	.NEXT

D.OFF	$GOTO
	ADD	(RT)+, SP
	BR	TJMP





CC$STK	== .

;;----------------------------------------------
;; Thunks common for both CRT and CC

L$POP::	POP	R0
	POP	R1
	BNE	NEXT.A
	PUSH	R0
IPOP:
D.OFF	I$POP
	POP	R0
NEXT.A:	.NEXT


I$RSH::	NEG	(SP)
I$LSH::	MOV	2(SP), R1
	ASH	(SP)+, R1
RET.R1:	MOV	R1, (SP)
	.NEXT


F$ADD::	FADD	SP
	.NEXT

F$SUB::	FSUB	SP
	.NEXT

F$MUL::	FMUL	SP
	.NEXT

F$DIV::	FDIV	SP
	.NEXT



D.OFF	$BEQ
	BNE	SKOFF
TJMP:
D.OFF	T$JMP
	ADD	(RT)+, RT
	.NEXT


D.OFF	$BNE
	BNE	TJMP
SKOFF:	TST	(RT)+
	.NEXT


;; (int)long
D.OFF	$L2I
	MOV	(SP)+, (SP)
	.NEXT
;; (long)int
D.OFF	$I2L
	POP	R1
	SXT	R0
PUR0R1:	PUSH	R0
PUR1:	PUSH	R1
	.NEXT


;;--- Must be adjacent. Used in PARITH
ISUB:
D.OFF	I$SUB
	NEG	(SP)
I$ADD::	ADD	(SP)+, (SP)
;;---
	.NEXT


I$AND::	COM	(SP)
	BIC	(SP)+, (SP)
	.NEXT

I$OR::	BIS	(SP)+, (SP)
	.NEXT

I$CMP::	POP	R0
	CMP	(SP)+, R0
	.NEXT

L$CMP::	POP	R0, R1, R2
	CMP	(SP)+, R1
	BNE	9$
	CMP	R2, R0
9$:	.NEXT



L$XOR::	MOV	(SP)+, R0
	MOV	(SP)+, R1
	XOR	R1, 2(SP)
	BR	XOR1

D.OFF	F$NEG
	PUSH	#100000
I$XOR::	MOV	(SP)+, R0
XOR1:	XOR	R0, (SP)
	.NEXT





;!!!? I$LOR:	TST	(SP)
;!!!?	BEQ	LCONT
;!!!R LSKIP:	MOV	(RT), R4
;!!!R 	.NEXT

$LOS::	BEQ	TRUE
$LO::	BLO	TRUE
	BR	FALSE

$HIS::	BEQ	TRUE
$HI::	BHI	TRUE
	BR	FALSE

$LEQ::	BEQ	TRUE
$LT::	BLT	TRUE
	BR	FALSE

$GEQ::	BEQ	TRUE
$GT::	BLT	FALSE
$NE:
D.OFF	O$NE
	BNE	TRUE
FALSE:	CLR	-(SP)
	.NEXT

;; Casts

D.OFF	$C2I
	CLR	R0
	BR	SC2I1

D.OFF	$SC2I
	TSTB	(SP)
	SXT	R0
SC2I1:	MOVB	R0, 1(SP)
	.NEXT

;; (long)unsigned
D.OFF	$U2L
	MOV	(SP), R1
	CLR	(SP)
	BR	PUR1


L$NEG::	POP	R1, R0
L$NEG1:	PUSH	#PUR0R1
;; Negate R0:R1 long
NEGR01:	NEG	R1
	ADC	R0
	NEG	R0
D.OFF	T$RET
RET.A:	RETURN

$BASE::


L$SUB::	NEG	(SP)
	ADC	2(SP)
	NEG	2(SP)
L$ADD::	ADD	(SP)+, 2(SP)
	ADC	4(SP)
	ADD	(SP)+, 2(SP)
	.NEXT

L$AND::	COM	(SP)
	BIC	(SP)+, 2(SP)
	COM	(SP)
	BIC	(SP)+, 2(SP)
	.NEXT

L$OR::	BIS	(SP)+, 2(SP)
	BIS	(SP)+, 2(SP)
	.NEXT




L$LNOT::BIS	(SP)+, (SP)
ILNOT:
D.OFF	I$LNO
	TST	(SP)+
$EQ::	BNE	FALSE
TRUE:	PUSH	#1
	.NEXT

IMUL:
D.OFF	I$MUL
	POP	R1
	MUL	(SP), R1
	BR	RET.R1

IDIV:
D.OFF	I$DIV
	CALL	DIV.
	MOV	R0, (SP)
	.NEXT


I$MOD:: PUSH	#RET.R1
DIV.:	POP	R2		; R2: return address
	MOV	2(SP), R1
	SXT	R0
	DIV	(SP)+, R0
	BVS	ERR.11
	JMP	(R2)
ERR.11:	.ERR	11.

L$RSH::	NEG	(SP)		; long >>
L$LSH::	POP	R2, R1, R0	; long <<
	ASHC	R2, R0
PU01.A:	BR	PUR0R1		; PUSH R0, R1; .NEXT


L$BNOT::COM	2(SP)
I$BNOT::COM	(SP)
	.NEXT

I$NEG::	NEG	(SP)
	.NEXT

;!!!R O.LAND:	TST	(SP)
;!!!R 	BEQ	LSKIP
;LCONT:	TST	(SP)+
;	BR	SKOFF



F$CMP::	FSUB	SP
	MFPS	R0
	CMP	(SP)+, (SP)+
	MTPS	R0
	.NEXT



.IF NE C$DBL
D.OFF	PU$64
	PUSH	(RT)+
	PUSH	(RT)+
.ENDC
D.OFF	PU$32
	PUSH	(RT)+		; long is represented as (high word, low word) in the Threaded code
D.OFF	PU$16
	PUSH	(RT)+
	.NEXT


D.OFF	$F2L
	MOV	R0, R1
	MOV	R0, R2
	MOV	R2, R3
	ASH	#-7, R2
	MOVB	R2, R2
	BMI	1$
	MOV	#177600, R2
1$:	SUB	#177600+32., R2	; R2: biased exponent
	BIC	#177600, R0
	BIS	#200, R0
	ASHC	R2, R0
	TST	R3
	BPL	PU01.A		; PUSH R0, R1; .NEXT
	BR	L$NEG1


$L2F::	POP	R1, R0
	BPL	$UL2F1
	CALL	NEGR01
	MOV	#150200, R2	; sign and biased exponent
	BR	$UL2F2

$UL2F::	POP	R1, R0
$UL2F1:	BNE	$UL2F3
	TST	R1
	BEQ	PU01.A		; PUSH R0, R1; .NEXT
$UL2F3:	MOV	#50200, R2	; biased exponent
$UL2F2:	SUB	#200, R2
	ASHC	#1, R0
	BCC	$UL2F3
	ASHC	#-9., R0
	BIC	#177600, R0
	BIS	R2, R0
	BR	PU01.A		; PUSH R0, R1; .NEXT


L$DIV::	JSR	R0, LDIMO
	.NEXT

L$MOD::	JSR	R0, LDIMO
	MOV	R2, R0
	MOV	R3, R1
	.NEXT


L$MUL::	POP	R4, R2		; R2:R4      = B
	MOV	(SP), R0	; 2(SP):(SP) = A
	MUL	R4, R0		; R0:R1 = signed Alo * Blo
	TST	(SP)
	BPL	1$
	ADD	R4, R0		; Correct high word to unsigned Alo * Blo
1$:	TST	R4
	BPL	2$
	ADD	(SP), R0
2$:	MUL	(SP)+, R2	; R2:R3 = Ahi * Blo
	ADD	R3, R0		; Add low word of cross product
	POP	R2
        MUL     R4, R2		; R2:R3 = Bhi * Alo
	ADD	R3, R0		; Add low word of cross product
        BR	PU01.A


.OFF	EQ$	, $EQ
.OFF	NE$	, $NE
.OFF	LOS$	, $LOS
.OFF	LO$	, $LO
.OFF	HIS$	, $HIS
.OFF	HI$	, $HI
.OFF	LEQ$	, $LEQ
.OFF	LT$	, $LT
.OFF	GEQ$	, $GEQ
.OFF	GT$	, $GT

.OFF	ADD$I	, I$ADD
.OFF	SUB$I	, ISUB
.OFF	MUL$I	, IMUL
.OFF	DIV$I	, IDIV
.OFF	MOD$I	, I$MOD
.OFF	LSH$I	, I$LSH
.OFF	RSH$I	, I$RSH
.OFF	AND$I	, I$AND
.OFF	OR$I	, I$OR
.OFF	XOR$I	, I$XOR
.OFF	ADD$L	, L$ADD
.OFF	SUB$L	, L$SUB
.OFF	MUL$L	, L$MUL
.OFF	DIV$L	, L$DIV
.OFF	MOD$L	, L$MOD
.OFF	LSH$L	, L$LSH
.OFF	RSH$L	, L$RSH
.OFF	AND$L	, L$AND
.OFF	OR$L	, L$OR
.OFF	XOR$L	, L$XOR
.OFF	ADD$F	, F$ADD
.OFF	SUB$F	, F$SUB
.OFF	MUL$F	, F$MUL
.OFF	DIV$F	, F$DIV

.OFF	BNOT$I	, I$BNOT
.OFF	BNOT$L	, L$BNOT
.OFF	LNOT$I	, ILNOT
.OFF	LNOT$L	, L$LNOT
.OFF	NEG$I	, I$NEG
.OFF	NEG$L	, L$NEG


;; Common part `long / long` and `long % long` operations
LDIMO:	TST	(SP)+
	POP	R4, R5, R2, R3
	PUSH	R0		; return address
	SUB	#8., SP
	MOV	SP, R1
	CALL	ldiv		; ldiv(R3:R2, R5:R4)
	POP	R2, R3, R0, R1
	RETURN



;.END
