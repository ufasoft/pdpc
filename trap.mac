;;;
;;; CC. TRAP Handlers

.TITLE	CRT0

.INCLUDE /macros.inc/

.IF NE C$CC
	.INCLUDE /ccmacr.inc/
.ENDC

.PSECT	.text

; R2.OFF	= 0	; to avoid explicit 0
R3.OFF	= 2
R4.OFF	= 4
R5.OFF	= 6
R0.OFF	= 10
PC.OFF	= 12
ST.OFF	= 14	; First Word Before Stack Frame ;   Number Of Saved Bytes In Stack Frame

.IF NE C$CC

.GLOBL	$L2I, $F2L, O$NE
.GLOBL	.ABORT, .OOM, MEMSTM, NEXTCH, NEXTB, NEXTD, RTOK, HAS.TO, NX.TOK, TDEFS, ENUMS, VARS
.GLOBL	STMT, PUNARY, IS.OPE
.GLOBL	PU$16, T$JMP, $BNE, $BEQ, I$POP, L$POP, SK$ST, AD$SP, callo$, $C2I, $SC2I, I$F
.GLOBL	LOCALS, ASCII, TMP2RA, TOKR
.GLOBL	PBINAR, TSTKB, EXTYPE, SV.ASC, GDEF, SYMBS, $READ, I$RD, $I2L, DEFGSD, GSD
.GLOBL	DCLTOR, TDECLS, IS.CE, GINI, TYPES, GINI, LINI
.GLOBL	EXPR., CHR.R


;; Invalid opcode ISR (vector 10)
I.INVO::PUSH	R1
	MOV	2(SP), R1
	CMPB	-(R1), #7000/400
	BEQ	CKTOK
	CMPB	(R1), #7400/400
	BEQ	EMI
	POP	R1
	JMP	@(PC)+
P.INVO::.WORD	0			; Previou Vector 10

;; .EMI
EMI:	MOVB	-(R1), R1
	ASL	R1
	ADD	#$OBASE+400, R1
	.EMIT
PO1RTI:	POP	R1
	RTI
;; CK.TOK
CKTOK:	MOVB	-(R1), -(SP)
	G.TOK
	CMPB	R1, (SP)+
	BEQ	PO1RTI
ERR.5:	.ERR	5		; Unexpected Token

CE.EV:	MOV	#TEXT+2, R4
	PUSH	(R4)
	INC	(R4)
	BIC	#1, (R4)
	MOV	(R4), RT	; RT: aligned TEXT offset to temporary const expression code
	DECB	IS.CE
	.EXPR
	MOV	R3, R1
	BEQ	1$
	.CAST
1$:	CLRB	IS.CE
	.EMIT	POP.N
	PO.EXT
	MOV	R1, 2(SP)	; Return type in R2
	CMP	R1, #TY.SYM
	BNE	3$
	MOV	#6, R1		; $SCRAT contains (Type, Offset, Symbol)
	BR	4$
3$:	SZ.TYP
4$:	.EMIT
	POP	(R4)		; Restore TEXT+2
	ADD	-(R4), RT	; RT: pointer to threaded code of Preprocessor expression
	.NEXT

ERR.8:	.ERR	8.


ITENUM:	G.SYMB
	MOV	R1, R0
	IF.TOK	T.ASGN, 1$
	MOV	NXENUM, R2
	BR	2$
1$:	EV.CIE
	MOV	R1, R2
2$:	MOV	R0, R1		; R1: Symbol
	PUSH.D	ENUMS
	INC	R2
	MOV	R2, (PC)+
NXENUM:	.WORD	0		; Next enum value
	RETURN


;; EV.CIE
CIE.EV: CLR	R3
	EV.CE
	CMP	R2, #TY.I
	BNE	ERR.8
	MOV	$SCRAT, R1
	BR	RE.A


;; Pop N bytes into $SCRAT
POP.N:	MOV	#$SCRAT, R2
1$:	POP	(R2)+
	SUB	#2, (RT)
	BGT	1$
RE.A:	BR	RE


.ENDC	; C$CC


;; Reserve vector
;; Ensure Vector capacity is enough to add BYTE or WORD
;; OUTPUT: R0: address to add a new item,  R5: pointer to Vector Size
RSVVEC:	PUSH	R1
	CLR	R2
	MOV	(R4)+, R5
	MOV	(R5), R1
	BEQ	2$
	MOV	-2(R1), R2		; R0: capacity
	CMP	2(R5), R2
	BLO	8$
2$:	ADD	#20, R2
	.REALLOC
	MOV	R0, (R5)
8$:	MOV	(R5)+, R0
	ADD	(R5), R0
        POP	R1
RTS.R3:	RTS	R3



;; TRAP instruction handler
;; Saves all registers except R1
I.TRAP::
	PUSH	R5, R4, R3, R2
	PUSH	12(SP)			; PSW
	MOV	12(SP), R4
	MOV	R4, PC.OFF+2(SP)	; Return address
	MOV	R0, R0.OFF+2(SP)
	MOV	-2(R4), R0		; Decode TRAP instruction
	CMP	R0, #OP.TRAP + 300
	BHIS	TRP300
	CMP	R0, #OP.TRAP + 100
	BHIS	TRP100
	CMP	R0, #OP.TRAP + 40
	BHI	SWIT.
TRPERR:	MOV	#ASTACK-200, SP		; Don't touch command line arguments
	MOV	#STKOVF, R5
	MOV	#10., R3
	MOVB	R0, R1			; .ERR processing
	BEQ	8$			; TRAP 0 (Stack Overflow)
.IF NE C$CC
	MOV	CURINP, R5
	BEQ	2$
	CMP	-(R3), -(R3)		; R3: 6

	ADD	R5, R3
	MOV	(R3), R5
	MOV	-(R3), R4
	MOV	R1, R3
	MOV	#MSGAT, R2
	MOV	stderr, R1
	.SUBRC	fprintf			; fprintf(stderr, "Error C%d at %s:%d", errcode, filename, linenum);
	MOV	R3, R1			; exit code
	BR	9$
.ENDC	; C$CC
2$:	MOV	#ERRSTR + 7, R2
	.SUBRC	itoa
	MOV	#ERRSTR, R5
8$:	.PRINT	R5
9$:	CALL	.ABORT

TRP100:	ASL	R0
	PUSH	TRAPS-<OP.TRAP+100*2>(R0)
CLRR0:	CLR	R0
	RTI

TRP300:	MOV	SUBRS-<OP.TRAP+300>(R0), SUBRA+2
	CALL	CLRR0
	BR	SUBRG

.IF NE C$CC

CH.IF:	CALL	RCH
	BCC	SKI4
	BNE	CH.IF		; is Space
	BR	CHIF1

BZ.PU:	CLR	R1
;; R1: byte value to push into array R4
B.PUSH:	JSR	R3, RSVVEC
	INC	(R5)
	MOVB	R1, (R0)
	BR	RE4

CAT.TY:	CMP	(R0)+, (R0)+	; R0: #TC.SCA
	BIT	#40000, R1
	BNE	1$
	MOV	R1, R0
	ADD	TYPES, R0
	MOVB	1(R0), R0
1$:	MOV	R0, (SP)	; Scalar
	BR	RE

GSD.:	CMP	(R0)+, (R0)+	; R0: 4
1$:	MOV	(R4)+, R1
	PUSH.W	GSD
	SOB	R0, 1$
	BR	RE4

.ENDC	; C$CC


;; switch
SWIT.:	TST	(SP)+		; Skip PSW
	BIC	#^c37, R0	; R0: count, up to 31.
1$:	JSR	R3, RDCASE
	SOB	R0, 1$
RE4::	MFPS	R3		; To return all flags
	MOV	R4, PC.OFF(SP)
	MTPS	R3
RE::	MFPS	R3
	MOV	R0.OFF(SP), R0
	MOV	R3, R0.OFF(SP)
	POP	R2, R3, R4, R5
	MTPS	(SP)+
	RETURN

;; Read value, label offset pair
;; Jumps ro label if low 7 bits of the value == R1
RDCASE:	MOVB	(R4)+, R2
	MOV	R2, (SP)		; Set sign of the Offset
	MOVB	(R4)+, (SP)
	SUB	R1, R2
	ASLB	R2
	BNE	RTS.R3
	POP	R2
	ASL	R2
ADR2R4:	ADD	R2, R4
	BR	RE4


.IF NE C$CC



TOK.IF:	MOV	R1, R0
	R.TOK
	BEQ	SKI4
	JSR	R3, RDCASE
	UN.TOK
	BR	RE4R0
SKI4:	TST	(R4)+		; CF: 0
RE4R0:	MOV	R0, R1
	BR	RE4



CHR.IF:	MOV	R1, R0		; Save
	R.CHR
CHIF1:	JSR	R3, RDCASE
	.UNGET
	BR	FWORE		; MOV R0, R1; SEC; BR RE4

EXT.PO: MOV	#EXTYPE, R5
	BR	W.POP1


.ENDC	; C$CC


W.POP:	MOV	(R4)+, R5
;!!!R	MOV	R4, PC.OFF(SP)		; POP.W must set flags based on R1
W.POP1:	MOV	(R5)+, R1
	MOV	(R5), R3
	SUB	#2, R3
	BCS	RE4
	MOV	R3, (R5)
	ADD	(R5), R1
	MOV	(R1), R1
	BR	RE4


SUBRC.:	.CKSTK
	MOV	(R4)+, SUBRA+2
	MOV	R4, PC.OFF(SP)
SUBRG:	MOV	R4.OFF(SP), R4
	PUSH	R1
SUBRA:	CALL	0		;SELF-MOD
PSUBRR:	POP	R1		; Keeps CF
SUBR.R:	MOV	R0, R0.OFF(SP)	; R0 determines Flags
RE.B:	BR	RE

;; .CALLOC sz
CALLS.:	PUSH	R1
	MOV	(R4)+, R1
	MOV	R4, PC.OFF+2(SP)	; R0 determines Flags
	.malloc
	BNE	PSUBRR
	BR	ERR.B
CALLO.:	.malloc
CALLO1:	BNE	SUBR.R
ERR.B:	JMP	.OOM

REALO.:	.SUBRC	realloc
	BR	CALLO1

W.PU2:	MOV	(R4)+, R3
	BR	W.PUS1


.IF NE C$CC
D.PUSH:	MOV	(R4), 1$+2
1$:	PUSH.W	0
	MOV	R2, R1
			; Fallthrogh
.ENDC	; C$CC
;; R1: word value to push into array R4
W.PUSH:	MOV	R1, R3
W.PUS1:	JSR	R3, RSVVEC
	ADD	#2, (R5)
	MOV	R3, (R0)
RE4.A:
RE4.B:	BR	RE4



W.REMO:	MOV	(R4)+, R0
	MOV	(R0)+, R5	; R0: points to vector length; R5: vector beginning
	MOV	R5, R3
	MOV	(R0), R2	; R2: length
1$:	SUB	#2, R2
	BMI	RE4.B
	MOV	(R3), (R5)+
	CMP	(R3)+, R1
	BNE	1$
	SUB	#2, (R0)
	TST	-(R5)
	BR	1$


.IF NE C$CC



FDWORA:	INC	R0
FDWOR.:	MOV	(R4)+, R2
	BEQ	ADR2R4			; CLC; BR RE4
	CMP	(R4)+, SYNAM1
	BNE	FDWORA
	CMP	R2, SYNAM0
	BNE	FDWORA
			; Fallthrough
FDWOE:	TST	(R4)+
	BEQ	FWORE
	TST	(R4)+
	BR	FDWOE


;; F.WORD
FWORA:	INC	R0
WORD.F:	MOV	(R4)+, R2
	BEQ	ADR2R4		; to CLC; BR RE4
	CMP	R2, R1
	BNE	FWORA
2$:	TST	(R4)+
	BNE	2$
FWORE:	MOV	R0, R1
SEC.4T:	SEC
	BR	RE4.B

FIND2.:	TST	(R0)+		; step: 6
FIND.:	CMP	(R0)+, (R0)+	; step: 4
	MOV	(R4)+, R3
	MOV	(R3)+, R5
	MOV	(R3), R3
	ADD	R3, R5		; R5: behind the vector
1$:	CMP	R0, R3
	BHI	RE4.B		; CF: 0
	SUB	R0, R3
	SUB	R0, R5
	CMP	(R5), R1
	BNE	1$
	TST	(R5)+
	MOV	(R5)+, R1
	CMP	R0, #6
	BNE	3$
	MOV	R5, R4.OFF(SP)
	MOV	(R5)+, (SP)	; return R2
3$:	BR	SEC.4T


;; R1: ASCIZ string to push into array R4
S.PUSH:	MOV	(R4)+, 2$+2
	MOV	R1, R2
1$:	MOVB	(R2)+, R1
2$:	PUSH.B	0		;SELF-MOD
	BNE	1$
	BR	RE4.B


CLEAR.: PUSH	R1
	MOV	(R4)+, R2
	CALL	TMP2RA		; MOV (R2), R1; CLR (R2)+; CLR (R2)+
	.free
POPRE4:	POP	R1
RE4.C:	BR	RE4.B


SYM.:	CLR	(SP)		; Set saved R2
	MOV	R1, R5
	.FIND	ENUMS
	BCS	8$
	MOV	R5, R1
	.FIND2	VARS
	BCC	RE.B
	INC	R0
	MOV	R1, (SP)	; R2.OFF(SP)
	MOV	R2, R1
8$:	BR	SUBR.R



NEXTB.:	DEC	R0
	CALL	NEXTB
RE.C:	BR	RE.B

CHR.G:	CALL	NEXTD
BEQERR:	BNE	RE.C
ERR.T:	.ERR


WS.SK:  CALL	NEXTD
	BEQ	RE.C
	.isspace
	BNE	WS.SK
UNGET.:	TSTB	R1
	BEQ	RE.C
	DEC	ASCII+2
	BGE	UNGE2.		;!!!?
	INC	ASCII+2
UNGE2.:	MOV	MEMSTM, R2
	BEQ	1$
	DEC	2(R2)
	BR	RE.C
1$:	MOV	CURINP, R2
	CMPB	R1, #C.NL
	BNE	2$
	DEC	6(R2)		; InputFile.line--
2$:	MOV	2(R2), R2	; FILE*
	CALL	ungetc
	BR	RE.C

EMIR1.:	PUSH.W	TEXT
	BR	RE.C

EMIT.:	PUSH	R1
EMIT.1:	MOV	(R4)+, R1
	.EMIT
	BR	POPRE4		; POP R1; BR RE4



;; Read mandatory symbol into $SCRAT
SYM.G:	G.TOK				; #arg stringify
SYM.G1:	CMPB	R1, #T.SYM
	BNE	ERR.T
	MOV	#$SCRAT, R1
	BR	RE.C

SYM.PP:	INCB	NO.EXP
	CALL	RTOK
	;!!!? G.SYM
	DECB	NO.EXP
	BR	SYM.G1



CHRPP2:	R.TOK
	BEQ	RE.C
	TST	ASCII+2
	BEQ	CHRPP2
	MOV	ASCII, R1
CHRPP1:	MOV	R1, (R2)
CHR.PP:	MOV	SP, IS.OPE		; Allow T.SP tokens
	MOV	#MODTOK, R2
	MOV	(R2), R0
	BEQ	CHRPP2
;; Read pre-read token (from ASCII)
;; R2: #MODTOK
	MOVB	(R0)+, R1
	BEQ	CHRPP1
	MOV	R0, (R2)
	BR	RE.C

INS.LS:	MOV	@(R4), (R1)
	MOV	R1, @(R4)+
	BR	RE4.C

DEL.LS:	MOV	(R4)+, R2
1$:	MOV	R2, R0
	MOV	(R0), R2
	BEQ	RE4.C
	CMP	R2, R1
	BNE	1$
8$:	MOV	(R1), (R0)
RE4.D:
RE4.E:	BR	RE4.C


TOK.G:	CALL	TOKR
	BR	BEQERR

TOK.UN:	INCB	HAS.TO
	MOV	ASCII, SV.ASC
	CLR	ASCII
	BR	RE.C


;; A.R50
;; INPUT: $SCRAT: ASCIZ string
;; RETURNS: SYNAM0:SYNAM1: CRADIX-50 representation
;; Saves R1
R50.A:	MOV	#$SCRAT, R4
	JSR	R3, A2R50A
SYNAM0::.WORD	0
	MOV	R5, R1
	JSR	R3, A2R50A
SYNAM1::.WORD	0
	BR	RE.C

COF.EM:	MOV	TEXT+2, R2
OFF.EM:	MOV	TEXT, R3
	ADD	R1, R3
	TST	-(R2)
	SUB	R1, R2
	MOV	R2, (R3)
RE.E:	BR	RE.C

ALG.SZ:	SZ.TYP
	INC	R1
	BIC	#1, R1
	ADD	R1, (SP)		; Add to Caller's R2
	BR	RE.E

TYP.SZ:	MOV	R1, R3
	BMI	5$    			; L-Value is pointer-size
	ASL	R1
	BMI	6$			; embedded types: int, long, float...
	ADD	TYPES, R3
	INC	R3
	MOVB	(R3)+, R1
	switch
	case	TC.PTR	, 5$		; pointer
	case	TC.ARR	, 7$		; array
	case	TC.SCT	, 1$		; struct
	case	TC.UNI	, 1$		; union
;!!!?	case	TC.ENU	, 5$		; enum
	case	TC.FUN	, RET.R0	; function (not pointer)
	case	TC.VOID	, RET.R0	;!!!? sizeof(void) == 0
	default
	.ERR

1$:	MOVB	R1, R4			; R4: TC.SCT or TC.UNI
	MOV	(R3), R3		; R3: list of fields
2$:	TST	(R3)+
	BEQ	RET.R0
	MOV	(R3)+, R1
	SZ.TYP
	CMPB	R4, #TC.SCT
	BEQ	3$
	CMP	R1, R0
	BLOS	4$
	CLR	R0
3$:	ADD	R1, R0
4$:	BR	2$

5$:	TST	(R0)+		; R0: 2
	BR	RET.R0
6$:	ASR	R3
	MOVB	TYSZ-<77760/2>(R3), R1
	BR	RE.E
7$:	MOV	(R3)+, R1
	SZ.TYP
	MUL	(R3), R1
RE.F:	BR	RE.E

ERR.17:	.ERR	17.


FLD.T:	MOV	R1, R5		; R5: Symbol
	.EXTYP
	NEG	R1
	ADD	TYPES, R1
	INC	R1
	MOVB	(R1)+, R3	; R3: TC.SCT or TC.UNI
	MOV	(R1), R2	; R2: list of fields
1$:	MOV	(R2)+, R4	; R4: field name
	BEQ	ERR.17
	MOV	(R2)+, (SP)	; Return Type in R2
	CMP	R4, R5
	BEQ	RET.R0
	MOV	(SP), R1
	CMPB	R3, #TC.UNI
	BEQ	1$
	SZ.TYP
	ADD	R1, R0
	BR	1$


BLK.OU:	TST	OULEN
	BEQ	1$
	OU.FIN
1$:	MOV	#1, R3
	OU.W
	CLR	R3
	OU.W
	MOV	(R4)+, R3
	OU.W
RE4.F:	BR	RE4.E

UNSIGN:	INC	R0
SIGNED:	INC	R0
TYPEP.: R.TOK
	BEQ	RE.E
TYPP2.:	CLR	R5
	switch
	case	T.VOID	, 18$
	case	T.INT	, 2$
	case	T.SHORT	, 13$
	case	T.LONG	, 17$
	case	T.CHAR	, 8$
	case	T.FLOA	, 10$
	case	T.DOUB	, 11$
	case	T.SIGN	, SIGNED
	case	T.UNSI	, UNSIGN
	case	T.SYM	, 14$
	case	T.CONST	, TYPEP.	; ignore `const`
	case	T.VOLA	, TYPEP.	; ignore `volatile`
	case	T.AUTO	, TYPEP.	; ignore `auto`
	case	T.REGI	, TYPEP.	; ignore `register`
	case	T.ENUM	, STRU
	case	T.STRU	, STRU
	case	T.UNIO	, STRU
	default
23$:	UN.TOK
	TST	R0
	BNE	2$			; `signed` or `unsigned`
	CLC
	BR	RET.R0

;; symbol
14$:	TST	R0
	BNE	23$
	.SYMB
	.FIND	TDEFS
	BCC	23$
	BR	RE.E

;; short
13$:	IF.TOK	T.INT, 2$
	BR	2$

;; long
17$:	IF.TOK	T.LONG, 19$
19$:	IF.TOK	T.INT, 4$
	IF.TOK	T.DOUB, 11$
	BR	4$

11$:
.IIF NE C$DBL BITB	(R5)+, (R5)+	; TY.DBL
10$:	BITB	(R5)+, (R5)+		; TY.FLT
4$:	ADD	#2, R5		; TY.L
2$:	ADD	#3, R5		; TY.I
8$:	ADD	#TY.C, R5
	ASR	R0
	BCC	20$
	BIS	#1, R5		; signed type
20$:	BIC	R0, R5		; clears lower bit on unsigned type
18$:	MOV	R5, R0
	SEC
RET.R0:	MOV	R0, R1
	BR	RE.F

FI.LOC:	MOV	R1, R4
	MOV	#LOCALS+2, R2
	MOV	(R2), R3	; R3: LOCALS+2
	MOV	-(R2), R5	; R5: LOCALS
	ADD	R3, R5
	ASR	R3
1$:	MOV	-(R5), R1	; R1: type
	CMP	-(R5), R4
	BEQ	FILOC2
	SOB	R3, 1$
	DEC	R0
RETR0A:	BR	RET.R0
FILOC2:	MOV	R5, R1
	TST	(R1)+
	SUB	(R2), R1	; SUB	LOCALS, R1
RE.G:	BR	RE.F

OF.LOC:	MOV	R1, R4
	MOV	LOCALS, R5
	MOV	LOCALS+2, R3
	ADD	R5, R4
	ADD	R3, R5		; R5: behind LOCALS
1$:	CMP	R5, R4
	BEQ	RET.R0
	MOV	-(R5), R1	; R1: local var type
	TST	-(R5)
	SZ.TYP
	EVN.UP
	ADD	R1, R0		; R0: accumulated offset
	BR	1$


B.OU:	PUSH	#RE
	BR	OUBYTE
W.OU:	PUSH	#RE
OUWORD:	CALL	(PC)
OUBYTE:	INC	OULEN
	CLR	R1
	BISB	R3, R1
	SWAB	R3
	ADD	R1, OUCSUM
	MOV	(PC)+, R2
OBJSTM::.WORD	0
	.fputc
	BPL	RET.C
	.ERR	10.

SHRIN.:	MOV	(R4)+, R5
	MOV	(R5)+, R1
	MOV	(R5)+, R2
	.REALLOC
RE4.G:	BR	RE4.F


VEC.SV:	MOV	(R4)+, R2
	MOV	R4, R5.OFF(SP)
	MOV	(R2), R0.OFF(SP)
	CLR	(R2)+
	MOV	(R2), PC.OFF(SP)
	CLR	(R2)
	POP	R2, R3, R4
RET.C:	RETURN



FIN.OU:	MOV	OBJSTM, R1
	MOV	OULEN, R5
	MOV	#2, R2
	SUB	R5, R2
	SXT	R3
	MOV	#1, R4
	PUSH	R1
	.fseek			; fseek(OBJSTM, -OULEN, SEEK_CUR)
	MOV	R5, R3
	OU.W
	NEG	R2
	SUB	#2, R2
	SXT	R3
	POP	R1		; R1: FILE*
	.fseek			; seek back
	MOV	(PC)+, R3
OUCSUM:	.WORD	0		; .OBJ section checksum
	CALL	OUBYTE
	CLR	(PC)+
OULEN:	.WORD	0
	CLR	OUCSUM
	BR	RE.G


;; C.RVAL
RVAL.C:	EXTY.P
	MOV	(R4), R1	; R1: type
	BPL	RE.G		; Already R-Value
	NEG	R1
	IS.ARR
	BCC	1$
	PTR.OF
	MOV	R1, (R4)
	BR	RE.G
1$:	MOV	R1, (R4)
	IS.FUN
	BEQ	RE.G
	MOV	R1, R0
;!!!R	BR	3$	;!!!O
;	IS.PTR
;	BCC	3$
;	IS.FUN
;	BNE	3$
;	MOV	R1, (R4)
;	MOV	R1, R0
;3$:	MOV	R0, R1
	SZ.TYP
	CMP	R1, #2
	BEQ	2$
	.EMI	$READ
	.EMIT
	BR	RETR0A
2$:	.EMI	I$RD
RETR0B:	BR	RETR0A

PEXPR1:	EM.POP
PEXPR.:	.EXPR
;	C.RVAL
	IF.TOK	T.COMMA, PEXPR1
	.EXTYP
	BR	RE.G


BEXPR.:	CK.TOK	T.LPAR
	.PEXPP
	CAST.B
	EM.POP
	BR	RE.G


PEXPP.:	.PEXPR
	CK.TOK	T.RPAR
	BR	RE.G


JMP.EM: .EMI	T$JMP
	MOV	TEXT+2, R2
	SUB	R2, R1
	SUB	#2, R1		; Don't use -(R1). R1 may be a garbage here
	.EMIT
	MOV	R2, R1
RE.H:	BR	RE.G

PLC.EM:	MOV	(R4)+, R1
	.EMIT
;!!!R	MOV	R4, PC.OFF(SP)
	BR	RETOFF

BNE.EM:	.EMI	$BNE
	BR	RETOFF


VEC.RE:	MOV	(R4)+, R5
	MOV	(R5), R1
	.free
	MOV	SP, R1
	ADD	#14, R1
	MOV	R1, R2
	MOV	(R1)+, (R5)+
	MOV	(R1)+, (R5)+
	MOV	#6, R0
1$:	MOV	-(R2), -(R1)
	SOB	R0, 1$
	MOV	R1, SP
RE4.H:	BR	RE4.G


BEQ.EM:	.EMI	$BEQ
RETOFF:	MOV	TEXT+2, R1
EMITRA:	BR	EMITRB		; Reserve a WORD for offset


ENUM:	CLR	NXENUM
	.ITER	ITENUM, T.RBRC
ENTYPE:	MOV	#TY.I, R1
	BIT	#2, R0
	BEQ	R.SEC		; enum
;; struct or union
	MOV	R3, R1
	.FIND	TDEFS
	BCS	RE.H
;	IF.TOK	T.SEMI, STRU8
;ERR.H:	.ERR	16.
;; struct/union name declaration
;STRU8:	UN.TOK
	MOV	R3, R1
	CLR	R2
	PUSH.D	TDEFS
R.SEC:	SEC
	BR	RE.H

;; enum, struct, union
STRU:	MOV	R1, R0		; R3: token (T.ENUM, T.STRU or T.UNIO)
	IF.TOK	T.SYM, 1$
	CLR	R3
	BR	2$
1$:	.SYMB
	MOV	R1, R3		; R3: Symbol
	BEQ	2$
	BIS	R0, R3
2$:	IF.TOK	T.LBRC, DSTRU
	TST	R3
	BNE	ENTYPE
ERR.H:	.ERR	16.	; No name or definition




POP.EM:	PO.EXT
	BEQ	RE.H
	SZ.TYP
	CMP	R1, #2
	BLOS	POPEM1
	.EMI	SK$ST
EMITRB:	BR	EMIT.R		; .EMIT; BR RE
POPEM1:	.EMI	I$POP
RE.I:	BR	RE.H


LCHR.R:	R.CHR
	CMPB	R1, #C.NL
	BNE	TSTRE
	BR	RETR0B		; MOV R0, R1; BR RE


;; Define enum, struct, union
DSTRU:	CMP	R0, #T.ENUM
	BEQ	ENUM
	MOV	TYPES+2, R2
	PUSH	R2		; (SP): Result TYPES offset
	MOV	R3, R1
	BEQ	2$		; Anonymous struct/union
	PUSH.D	TDEFS
2$:	MOV	R0, R1
	SWAB	R1
	TST	(R1)+
	PUSH.D	TYPES
	MOV	SP, R4		; R4: Saved SP
3$:	JSR	R5, TDECLS
	IF.TOK	T.RBRC, 4$
	BR	3$
4$:	MOV	R4, R1
	SUB	SP, R1
	TST	(R1)+		; +2 for terminating Zero
	.CALLOC
	MOV	(R4), R5	; R4: Saved TYPES offset
	ADD	TYPES, R5
	MOV	R0, 2(R5)
	MOV	R4, R5
5$:	MOV	-(R5), (R0)+
	CMP	R5, SP
	BNE	5$
	MOV	R4, SP
	POP	R1
RSEC.A:	BR	R.SEC


ITER.:	MOV	(R4)+, R5	; callback
	MOV	(R4)+, R2	; terminator
1$:	G.TOK
	CMPB	R1, R2		;!!!O use IF.TOK with reference forward to keep the High bit == zero
	BEQ	RE4.J		; TSR (R4)+, MOV R0, R1, BR RE4
	UN.TOK
	MOV	R5, 2$+2
2$:	.SUBRC	0
	IF.TOK	T.COMM, 1$
	MOVB	R2, 3$
3$:	CK.TOK	0
RE4.J:	BR	RE4.H





I.CAST:	MOV	#TY.I, R1
CAST.:	TST	(R0)+		; R0: 2
	MOV	R1, R2		; R2: Target Expression Type
	SZ.TYP
	MOV	R1, R3		; R3: Target type Size
	C.RVAL
	MOV	R1, R5		; R5: Current Expression Type
	SZ.TYP
	MOV	R1, R4		; R4: Current Expression Type Size
	CMP	R3, R0
	BHI	5$
	CMP	R4, R0
	BLOS	6$
5$:	MOV	R5, R1		; R1: Current Expression Type
	MOV	R5, R4		; R4: Current Expression Type
	XOR	R2, R4
	ASR	R4
	BEQ	ECASTA		; Types differ only by sign
	BICB	#200, R1
	switch
	case	TY.C	, FROMC
	case	TY.SC	, FROMSC
	case	TY.I	, FROMI
	case	TY.UI	, FROMU
	case	TY.L	, FROML
	case	TY.UL	, FROMUL
	case	TY.FLT	, FROMF
	default
	IS.PTR
	BR	ERR.H		;!!!?

6$:	CMP	R5, #TY.SYM
	BNE	ECAST
CSTSYM:	MOV	R2, R1		; R1: Target Type
	IS.PTR
BCCERH:	BCC	ERR.H
	.EMI	I$POP		; Replace pointer target
	.EMI	PU$16
	.EMIT
	MOV	R5, R2		; R2: #TY.SYM
ECASTA:	BR	ECAST



;;!!!R ASGMT.: PUSH	TSTKB
;;!!!R 	CALL	PASGMT

EXPR.2::POP	TSTKB
	BR	RE.I


UNWTO.:	LOC.OF
	BEQ	RE.I
	.EMI	AD$SP
EMIT.R:	.EMIT
	BR	RE4.J


NEXTC.:	CALL	NEXTCH
TSTRE:	TST	R1
RE.J:	BR	RE.I

;; PTR.OF
OF.PTR:	MOV	#TYPES, R2
	MOV	(R2)+, R3
	MOV	R3, R5
	ADD	(R2), R5	; end-of-table
1$:	ADD	R0, R3
	CMP	R3, R5
	BHIS	5$
	MOVB	(R3)+, R0	; R0 Size
	MOVB	(R3)+, R4	; Kind of Type
	CMP	R4, #TC.PTR
	BNE	1$
	CMP	(R3), R1
	BNE	1$
	TST	-(R3)
	SUB	-(R2), R3
	BR	6$
5$:	MOV	(R2), R3
	MOV	R1, R2
	MOV	#TC.PTR*400+2, R1
	PUSH.D	TYPES
6$:	PUSH	R3
	POP	R1
	BR	RE.J


ARR.IS:	DEC	R0		; TC.ARR
PTR.IS:	ADD	#TC.PTR, R0
	TY.CAT
	CMP	R2, R0
	BNE	1$
	MOV	R1, R2
	ADD	TYPES, R2
	MOV	2(R2), R1
	BR	RSEC.A
1$:	CLC
	BR	RE.J



EMSYM.:	MOV	(R4)+, SYNAM0
	CLR	SYNAM1
	MOV	(R4)+, R1	; R1: address
	TSTB	IS.CE
	BNE	2$
	MOV	#4*400+100, R3	; Global Symbol Name
	CALL	DEFGSD
	.SYMB
	MOV	R1, R2
	MOV	TEXT+2, R1
	PUSH.D	RELOCS
	CLR	R1
2$:	.EMIT
RE4.K:	BR	RE4.J



;; C.LVAL
LVAL.C:	.EXTYP
	IS.PTR
	BCC	BCCERH		; BCC ERR.H
NEG.R1:	NEG	R1
	BR	RE.J

UNRV.P:	.UNARY
	C.RVAL
	BR	RE.J

TOK.R:	CALL	TOKR		;!!!O
	BR	RE.J

LCAST:	.EMI	$I2L
			; Fallthrough
ECAST:	EXTY.P
	MOV	R2, (R4)
RE.K:	BR	RE.J


SYMB.:	MOV	#SYMBS+2, R3
	TST	(R3)		; TST SYMBS+2
	BNE	1$
	MOV	#-1, R1		; First slot is reserved to avoid zero offsets
	MOV	R1, R2
	PUSH.D	SYMBS
1$:	MOV	SYNAM0, R1
	MOV	SYNAM1, R2
	MOV	(R3), R5
	ADD	-(R3), R5
2$:	CMP	R5, (R3)
	BEQ	5$
	MOV	-(R5), R0
	CMP	-(R5), R1
	BNE	2$
	CMP	R0, R2
	BNE	2$
	MOV	R5, R1
	SUB	(R3), R1	; SUB SYMBS, R1
	BR	4$
5$:	PUSH.D	SYMBS
	MOV	SYMBS+2, R1
	CMP	-(R1), -(R1)
4$:	BR	TSTRE		; TST R1; BR RE




SYMB.G:	G.SYM
	.SYMB
	BR	RE.K

FROMC:	.EMI	$C2I
	BR	FROMI
FROMSC:	.EMI	$SC2I
FROMI:	MOV	R2, R1
	BICB	#200, R1
	switch
	case	TY.L	, LCAST
	case	TY.UL	, LCAST
	case	TY.FLT	, FROMI2
	default
ERR.C:	.ERR
FROMI2:	.EMSYM	<^rI$F>, I$F
	BR	ECAST




STMT.:	PUSH	TDEFS+2, LOCALS+2
	CALL	STMT
	MOV	(SP), R1
	.UNWTO
	POP	LOCALS+2, TDEFS+2
	BR	RE.K




FROMU:	MOV	R2, R1
	BICB	#200, R1
	switch
	case	TY.L	, 1$
	case	TY.UL	, 1$
	default
	.ERR
1$:	.EMI	$U2L
	BR	ECAST
FROMUL:	CMP	R2, #TY.FLT
	BNE	FROML
	.EMIT	$UL2F
	BR	ECAST
FROML:	MOV	R2, R1
	BICB	#201, R1
	switch
	case	<TY.C & 176>	, 2$
	case	<TY.I & 176>	, 2$
	case	<TY.FLT & 176>	, 4$
	default
	.ERR
2$:	.EMI	$L2I
	BR	ECAST
4$:	.EMIT	$L2F
ECAS.A:	BR	ECAST


FROMF:	MOV	R2, R1
	BICB	#200, R1
	switch
	case	TY.L	, 2$
	case	TY.UL	, 2$
	default
1$:	.EMI	$F2L
	.EMI	$L2I
	BR	ECAS.A
2$:	.EMI	$F2L
	BR	ECAS.A

FUN.IS: TY.CAT
	CMP	R2, #TC.FUN
RE.L:	BR	RE.K



P.EXTY: MOV	EXTYPE+2, R4
	ADD	EXTYPE, R4
	TST	-(R4)
	MOV	R4, R4.OFF(SP)
	BR	RE.L

B.CAST:	C.RVAL
	EM.POP
	.EMI	O$NE
TYI.PU:	MOV	#TY.I, R1
			; Fallthrough
EXT.PU:	PUSH.W	EXTYPE
	BR	RE.L

EXTYP.:	PO.EXT
	BR	EXT.PU

;!!!R	EXTY.P
;	MOV     (R4), R1
;	BR      RE.L



TYPED.:	.TYPEP
	BCC	ERR.C
	MOV	R1, R3
DCL.T:	CALL	DCLTOR
	MOV	R2, (SP)	; Return Type in R2
	BR	RE.L

TRY2I.:	CMP	R1, #TY.C
	BEQ	1$
	CMP	R1, #TY.SC
	BNE	9$
1$:	MOV	#TY.I, R1
9$:	BR	RE.L


UP.EVN:	INC	R1
	BIC	#1, R1
	BR	RE.L


;; Encode 3 chars of C identifier in (R4) to CRADIX-50
A2R50A:	CLR	R5
	MOV	#3, R2
1$:	MUL	#50, R5
	TSTB	(R4)
	BEQ	5$
	MOVB	(R4)+, R0
	CMP	R0, #'_
	BEQ	3$
	BIC	#40, R0
	SUB	#100, R0
	BGT	4$
	ADD	#36 + 100 - 20 - 34 + '_, R0
3$:	ADD	#34 - '_, R0
4$:	ADD	R0, R5
5$:	SOB	R2, 1$
	MOV	R5, (R3)+
	RTS	R3


.ENDC	; C$CC

; .RDATA



TRAPS:	.WORD	W.REMO	, W.PUSH	, REALO.	, W.POP		, SUBRC.	, CALLS.				; 100
.IF NE C$CC
	.WORD                                                                                            ARR.IS		, TYPP2.	; 106
	.WORD	CH.IF	, TYI.PU	, EMSYM.	, EXTYP.	, CAST.		, I.CAST	, VEC.RE	, VEC.SV	; 110
	.WORD	CE.EV	, SYMB.G	, GSD.		, DCL.T		, FLD.T		, TRY2I.	, B.CAST	, P.EXTY	; 120
	.WORD	CHR.R	, CHR.G		, UNGET.	, CHR.IF	, B.PUSH	, SYM.G		, WS.SK		, CHR.PP	; 130
	.WORD	WORD.F	, INS.LS	, DEL.LS	, R50.A		, FDWOR.	, CLEAR.	, POP.EM	, JMP.EM	; 140
	.WORD	UP.EVN	, OFF.EM	, COF.EM	, PLC.EM	, CIE.EV	, BEXPR.	, PEXPR.	, ITER.		; 150
	.WORD	TOK.G	, TOK.IF	, TYPED.	, TOK.UN	, TYPEP.	, FIND.		, FIND2.	, SYM.		; 160
	.WORD	BLK.OU	, W.OU		, FIN.OU	, PTR.IS	, OF.PTR	, TYP.SZ	, RVAL.C	, LVAL.C	; 170
	.WORD	EMIT.	, ALG.SZ	, EXPR.		, EXT.PO	, UNRV.P	, OF.LOC	, CAT.TY	, UNWTO.	; 200
	.WORD	STMT.	, BZ.PU		, CALLO.	, UNGE2.	, LCHR.R	, NEXTC.	, TOK.R		, SHRIN.	; 210
	.WORD	NEXTB.	, SYM.PP	, EMIR1.	, FI.LOC	, BEQ.EM	, BNE.EM	, EXT.PU	, W.PU2		; 220
	.WORD	SYMB.	, B.OU		, FUN.IS	, PEXPP.	, B.PUSH	, S.PUSH	, D.PUSH	 	; 230
																	; 240
.EVEN

;.PSECT	.data

MODTOK:	.WORD	0		; Pointer in the current Token

.ENDC	; C$CC

SUBRS:	.WORD	strlen		, strcmp	, strcpy	, isspace								; 300
	.WORD	callo$		, free		, fputc		, isdigit								; 310
	.WORD	fputs		, fgetc		, fclose	, fseek									; 320
	.WORD	isxdigit														; 330
.IF NE C$CC
	.WORD			strcat		, GINI		, LINI									; 330
	.WORD	PUNARY		, fopen													; 340

TYSZ:	.BYTE	2, 2, 2, 1, 2, 4, 4	; sizeof(sym, , unk, char, int, long, float)
.IIF NE C$DBL	.BYTE 8.


MSGAT:	.ASCIZ	"Error C%d at %s:%d"<C.NL>

.ENDC

ERRSTR:	.ASCIZ	"Error C"
STKOVF:	.ASCIZ	"Stack overflow"


.END
