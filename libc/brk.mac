.TITLE	BRK

.INCLUDE /macros.inc/

.GLOBL

.PSECT	.text

;;int brk(void *addr)
brk::
	MOV	$USRTO, R2
	TST	-(R1)
	.SETTOP	R1
	SUB	R1, R0
	BEQ	RET.A
RESBRK:	.SETTOP	R2		; Restore previous break value
	CALL	RNOMEM		; MOV	#ENOMEM, errno; CLR R0
	DEC	R0		; R0: -1
RET.A:	RETURN


;;void *sbrk(intptr_t increment)
sbrk::
	MOV	$USRTO, R2
	ADD	R2, R1
	.SETTOP	R1
	SUB	R1, R0
	BNE	RESBRK
	MOV	R2, R0
	TST	(R0)+
	RETURN


.END
