.TITLE	SLEEP

.INCLUDE /macros.inc/

.GLOBL	clock, CLOCKS


.PSECT	.text

;; unsigned sleep(unsigned sec)
sleep::
	MUL	CLOCKS, R1	; R1: sec * CLOCKS_PER_SEC
	.SUBRC	clock
	ADD	R0, R1		; R1: target clock_t value
1$:	.SUBRC	clock
	CMP	R0, R1
	BLT	1$
	CLR	R0
	RETURN

.END
