.TITLE	BSEARCH

.INCLUDE /macros.inc/

.PSECT	.text

;; void* bsearch(const void *key, const void *ptr, size_t count, size_t size, int (*comp)(const void*, const void*))
bsearch::
	CLR	R4		; R5: left index, R3: right index
1$:	MOV	R4, R5
2$:     CMP	R5, R3
	BEQ	7$		; Not found
	MOV	R5, R4
	ADD	R3, R4
	ASR	R4		; R4: middle of the current range
	MOV	R4, R2
	MUL	ARG4, R2	; *= size
	ADD	ARG1(SP), R2
	MOV	ARGV5(SP), 4$+2	; Invoke `comp`
4$:	.SUBRC	0
	BEQ	8$
	BGT	6$
	MOV	R4, R3
	BR	2$
6$:	CMP	R4, R5
	BNE	1$
7$:	CLR	R2
8$:	MOV	R2, R0
	RETURN

.END
