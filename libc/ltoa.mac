.TITLE	LTOA

.INCLUDE /macros.inc/

.GLOBL	$EXITH, $POR0

.TEXT

;; char* itoa(int value, char* buf, int base)
itoa::
	MOV	R3, R4
	MOV	R2, R3
	TST	R1
	SXT	R2
			; Fallthrough
;; char* ltoa(long val, char* buf, int base)
ltoa::
	PUSH	R3
	TST	R2
	BPL	1$
	NEG	R1
	ADC	R2
	NEG	R2
	MOVB	#'-, (R3)+
1$:	PUSH	#$POR0		; POP R0; RETURN
			; Fallthrough
;; char* ultoa(unsigned long val, char* buf, int base)
ultoa::	PUSH	R3
	MOV	R4, R0		; R0: base
2$:	CLR	R4
	MOV	R2, R5
	DIV	R0, R4
	MOV	R4, R2
	MOV	R5, R4
	MOV	R1, R5
3$:	DIV	R0, R4
	CMP	R5, #10.
	BLO	4$
	ADD	#'a-'0-10., R5
4$:	ADD	#'0, R5
	MOVB	R5, (R3)+
	MOV	R4, R1
	MOV	R2, R4
	BNE	2$
	MOV	R1, R5
	BNE	3$     		; 16-bit dividend, save DIV instruction
	CLRB	(R3)
	POP	R1
			; Fallthrough
;; char *strrev(char *str)
strrev::
	.strlen
	MOV	R1, R2
	ADD	R0, R2		; R2: points behind the end
	MOV	R1, R0		; Result is `str`
1$:	CMP	R1, R2
	BHIS	RET.B
	MOVB	-(R2), R3
	MOVB	(R1), (R2)
	MOVB	R3, (R1)+
	BR	1$

;; int atexit(void (*func)(void))
atexit::
	PUSH.W	$EXITH
RET.B:	RETURN


.END
