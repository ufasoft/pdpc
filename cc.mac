.TITLE	CC - C compiler for PDP-11 (RT-11 OS)
.IDENT	/2026.1/

C$CC	= 1



.INCLUDE /macros.inc/
.INCLUDE /ccmacr.inc/



.GLOBL	ERREXI, PPDEF, PPCUR, OPNINP, PDECLS, PPDEF, GSD, SYMBS, VARS, ABSS, EBSS, OBJSTM, TYPES
.GLOBL	TEXT, RDATA, RELOCS, DGSD, I.INVO

.ASECT

. = $JSW
	.WORD	CHNIF$

. = 1000


;; Macro sefinitions
MDEFS::


5$:
ERR.B:	.ERR


. = 1000


HELP:	.ASCII	"PDP C Compiler 2026.1 ufasoft.com/pdpc  (c) Sergey Pavlov"<C.NL>
        .ASCII	"Usage: CC [options] file.c"<C.NL>
        .ASCII	"OPTIONS:"<C.NL>
        .ASCII	" -c"<C.HT><C.HT>"Compile, but don't link"<C.NL>
        .ASCII	" -D sym"<C.HT><C.HT>"Define sym=1"<C.NL>
        .ASCII	" -E"<C.HT><C.HT>"Preprocess"<C.NL>
        .ASCIZ	" -o fname"<C.HT>"Place output in fname"

INVOPT::.ASCIZ	"Invalid option"

.EVEN

PHELP:	MOV	#HELP, R1
	CALL	puts
	JMP	EXIT

;; Change filename ext
;; R1: filename, R3: new ext including dot
CHEXT:	MOV	#'., R2
	.SUBRC	strrchr
	BEQ	RET.C
	CLRB	(R0)
	MOV	R3, R2
	JMP	strcat
RET.C:	RETURN


;!!!R :	MOV	CURFN, R1
ERR.R1:
ERREXI::CALL	perror
	MOV	errno, R1
	JMP	exit
	; Unreachable



MAIN::	MOV	#10, R5
	CMP	(R5), #I.INVO
	BEQ	1$		; avoid double ISR chaining
	MOV	(R5), P.INVO
	MOV	#I.INVO, (R5)
1$:
	; DEC	R1
	; BEQ	PHELP		; argc == 1

	MOV	R2, R4		; R4: argv
	TST	(R4)+		; R4: &argv[1]
PAARGV:	MOV	(R4)+, R2
	BEQ	PHELP
	MOVB	(R2), R1
	switch
	case	'/, OPTION
	case	'-, OPTION
	default
	MOV	R2, CURFN	; Source filename
	MOV	#OBJFN, R1
	.strcpy
	TSTB	LINKE-1		; char after LINK:/EXE
	BNE	12$
	MOV	OUTFN, R2
	BNE	11$
	MOV	#SAVEXT, R3
	.SUBRC	CHEXT
	MOV	R1, R2
11$:	PUSH	R1
	MOV	#LINK, R1
	.strcat
	POP	R1
12$:	MOV	#OBJEXT, R3
	.SUBRC	CHEXT
	PUSH.W	TYPES, 0	; first WORD for `void`
	MOV	(PC)+, R1
CURFN:	.WORD	0		;SELF-MOD
	CALL	OPNINP
	BEQ	ERREXI
	TST	(PC)+
PPONL::	.WORD	0		;SELF-MOD	-E Preprocess only
	BEQ	3$
	JMP	PREPRO
3$:	MOV	#OBJFN, R1
	MOV	#WMODE, R2
	.fopen
	BEQ	ERR.R1
	MOV	R0, OBJSTM

	MOV	$DEVBL+2, R1	; Module name
	MOV	$DEVBL+4, R2
	CLR	R3
	CALL	DGSD

	.GSD	<. ABS.>, 5, 104, 0
	.GSD	<.text >, 5, 40, 0	; Relocatable I-section

;!!!R	PUSH.W	TEXT		; Reserve for .START reference
;!!!R	.GSD	<.start>, 4, 100, 0	; Global Symbol `_start` to link CRT0.OBJ

	JMP	COMPIL

OPTION:	MOVB	1(R2), R1
	switch
	case	'D	, 5$
	case	'E	, 7$
	case	'c	, 8$
	case	'o	, 3$
	default
	MOV	#INVOPT, R1
	CALL	puts
9$:	.ERR	1

5$:	CMPB	(R2)+, (R2)+
	TSTB	(R2)
	BNE	2$
	MOV	(R4)+, R2
	BEQ	9$
2$:	MOV	R2, R1
	MOV	#ONE, R2
	.SUBRC	PPDEF
	BR	PAARGV

7$:	INCB	PPONL
8$:	INCB	COONL
	BR	PAARGV
3$:	MOV	(R4)+, (PC)+
OUTFN:	.WORD	0       ;SELF-MOD	OUTFN Output (.SAV) filename
	BR	PAARGV

WMODE:	.ASCIZ	"w"
OBJEXT:	.ASCIZ	".OBJ"
SAVEXT:	.ASCIZ	".SAV"
ONE:	.ASCIZ	"1"


.EVEN


.IIF	GT . - ASTART	.ERROR CC init code out of bounds


.PSECT	.text




;; Outputs up to 128. bytes of TEXT to .OBJ
;; RETURNS CF=1 if the TXT section was written
OUTEXT: MOV	#TEXT+2, R0
OUTSEC:	MOV	(PC)+, R3
NXLDAD:	.WORD	0		; Next Address of the current 128.-byte .OBJ TXTsection
	MOV	R3, (PC)+
LDAD:	.WORD	0		; Address of the current 128.-byte .OBJ TXTsection
	CMP	R3, (R0)	; CMP R3, vec+2
	BHIS	9$
	OU.BLK	BT.TXT
	OU.W
	MOV	R3, R4
	MOV	(R0), R5	; MOV vec+2, R5
	ADD	-(R0), R4	; ADD vec, R4
	SUB	R3, R5
	CMP	R5, #128.
	BLO	5$
	MOV	#128., R5
5$:	MOVB	(R4)+, R3
	OU.B
	SOB	R5, 5$
	SUB	(R0), R4	; SUB vec, R4
	MOV	R4, NXLDAD
	SEC
9$:	RETURN



INIRLD:	OU.BLK	BT.RLD
	MOV	#7, R3		;  Location Counter Definition
	OU.W
	MOV	(R5)+, R3
	OU.W
	MOV	(R5)+, R3
	OU.W
	CLR	R3
	OU.W
	RTS	R5



COMPIL:	CALL	PDECLS

;!!!T	.GSD	<.rdata>, 5, 40, 0	; Relocatable I-section
	.GSD	<.rdata>, 5, 260, 0	; Relocatable read-only D-section

	MOV	GSD, R4
	MOV	TEXT+2, 26(R4)		; Write `Maximum length` field of .text P-Sect entry in GSD
	MOV	GSD+2, R3
	ADD	R4, R3
	MOV	RDATA+2, -(R3)		; Write `Maximum length` field of .rdata P-Sect entry in GSD


;; Write Transfer Address
	.GSD	<. ABS.>, 3, 10, 1	; Transfer Address

	OU.BLK	BT.GSD
;; Write GSD to .OBJ section
	MOV	GSD+2, R0		; R0 > 0
21$:	MOVB	(R4)+, R3
	OU.B
	SOB	R0, 21$
22$:



	OU.BLK	BT.EGS

;; Write init RLD
	JSR	R5, INIRLD
	.RAD50	/.text/

;; Write TXTs and RLDs
	MOV	RELOCS, R5
	PUSH	R5
	ADD	RELOCS+2, (SP)	; (SP): Pointer to the End of RELOCS
1$:	.SUBRC	OUTEXT
	OU.BLK	BT.RLD
2$:	CMP	R5, (SP)
	BHIS	3$
	CMP	(R5), NXLDAD
	BHIS	1$
	MOV	(R5)+, R3
	SUB	LDAD, R3
	SWAB	R3
	MOV	(R5)+, R2
	BMI	4$		; .rdata
	MOV	R2, R1		; R1: Symbol
	.FIND2	VARS
	BCC	11$
	TST	(R4)
	BMI	9$		; Declared but not-defined Symbol
	ADD	#2001, R3	; Internal relocation
	MOV	R4, R2		; R2: address of Offset field in VARS record
	BR	12$
9$:	MOV	-4(R4), R2	; R2: Symbol
11$:	ADD	#2002, R3	; Global relocation
	ADD	SYMBS, R2
	OU.W
	MOV	(R2)+, R3
12$:	OU.W
	MOV	(R2)+, R3
10$:	OU.W
	BR	2$
4$:	ADD	#2015, R3	; Additive relocation
	OU.W
	MOV	#^R.rd, R3
	OU.W
	MOV	#^Rata, R3
	OU.W
	COM	R2
	MOV	R2, R3
	BR	10$

3$:	TST	(SP)+
13$:	CALL	OUTEXT
	BCS	13$

	TST	RDATA+2
	BEQ	8$
	JSR	R5, INIRLD
	.RAD50	/.rdata/

	CLR	NXLDAD
14$:	MOV	#RDATA+2, R0
	CALL	OUTSEC
	BCS	14$

8$:	OU.BLK	BT.END
	OU.FIN

	MOV	OBJSTM, R1
	.fclose


	MOV	#LINK, R1
	MOV	#OBJFN1, R2
	.strcat
	MOVB	#C.COMM, (R2)
	TST	(PC)+
COONL:	.WORD	0		;SELF-MOD	 -c Compile only
	BNE	FINISH
	MOV	#$CLBUF, R1
	MOV	#LINK, R2	; R1: #CLBUF here
	.strcpy
	MOV	#CLIB, R2
	.strcat
;	.SUBRC	puts
	.strlen
	INC	R0		; Count '\0'
	MOV	R0, -(R1)	; $CLLEN = strlen($CLBUF)
;	BIS	#CHNIF$, $JSW
	CALL	RESV10
	CLR	R0
	.EXIT

PREPR1:	.TTYOUT	R1
PREPRO:	PP.CHR		;!!!TODO Optimize. This is the only usage
	BNE	PREPR1
FINISH:	CLR	R1
	PUSH	#exit
		; Fallthrough
;; Restore 10 vector
RESV10::
	MOV	P.INVO, 10
	RETURN


.RDATA

CLIB:	.ASCIZ	",CRT0,C.LIB"

.PSECT	.data


OBJFN1:	.BYTE	C.SP
OBJFN:	.BLKB	15

;; Link command line
LINK:	.ASCIZ	"LINK/EXE:"
LINKE:	.BLKB	30.		;!!!O


.END
