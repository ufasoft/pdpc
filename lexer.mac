.TITLE	CHR

.SBTTL	Char literal Parser


.INCLUDE /ccmacr.inc/


.TEXT

PACHR1::.NEXTB
PACHR2::CMPB	R1, #'\
	BNE	9$
	MOV	#ESCTAB, R2
	.NEXTB
1$:	CMPB	(R2)+, R1
	BEQ	3$
	TSTB	(R2)+
	BNE	1$
	MOV	#$SCRAT, R2
	MOV	R2, R4
	MOV	#8., R3
	.isdigit
	BEQ	4$
	MOVB	R1, (R4)+
	.NEXTB
	.isdigit
	BEQ	5$
	MOVB	R1, (R4)+
	.NEXTB
	.isdigit
	BNE	7$
5$:	.UNGET
	BR	6$
4$:	CMPB	R1, #'x
	BNE	9$
	ASL	R3			; R3: 16.
	.NEXTB              		; \xDD
	MOVB	R1, (R4)+
	.NEXTB
7$:	MOVB	R1, (R4)+
6$:	CLRB	(R4)
	MOV	R2, R1
	.SUBRC	strtol
	MOV	R0, (R2)
3$:	MOVB	(R2), R1
9$:	RETURN




.RDATA

ESCTAB:	.BYTE	'a, C.BEL
	.BYTE	'b, C.BS
	.BYTE	'n, C.NL
	.BYTE	'r, C.CR
	.BYTE	'f, C.FF
	.BYTE	't, C.HT
	.BYTE	'v, C.VT
	.BYTE	'e, C.ESC
	.BYTE	0, 0


.END
